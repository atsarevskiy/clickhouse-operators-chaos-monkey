+// TraceActionPlan renders a one-line summary of which parts of an action plan differ, with at most
+// a few spec paths, cheap enough for a per-event log line.
+func TraceActionPlan(plan IActionPlan) string {
+	ap, ok := plan.(*ActionPlan)
+	if !ok || ap == nil {
+		return "ap=none"
+	}
+	paths := func(d *messagediff.Diff) (added, removed, modified int, sample string) {
+		if d == nil {
+			return 0, 0, 0, ""
+		}
+		var all []string
+		for _, items := range []map[*messagediff.Path]interface{}{d.Added, d.Removed, d.Modified} {
+			for p := range items {
+				all = append(all, util.PrintPath(p, ""))
+			}
+		}
+		sort.Strings(all)
+		if len(all) > 5 {
+			all = append(all[:5], "...")
+		}
+		return len(d.Added), len(d.Removed), len(d.Modified), strings.Join(all, ",")
+	}
+	sa, sr, sm, sp := paths(ap.specDiff)
+	la, lr, lm, _ := paths(ap.labelsDiff)
+	return fmt.Sprintf(
+		"specEqual=%t specAdded=%d specRemoved=%d specModified=%d specPaths=[%s] labelsEqual=%t labelsChanged=%d deletionTimestampEqual=%t finalizersEqual=%t attributesEqual=%t",
+		ap.specEqual, sa, sr, sm, sp, ap.labelsEqual, la+lr+lm, ap.deletionTimestampEqual, ap.finalizersEqual, ap.attributesEqual,
+	)
+}
