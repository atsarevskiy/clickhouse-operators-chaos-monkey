+
+func chaosReplicaDiff(replica replicaState, revs chctrl.RevisionState) []any {
+	kv := []any{
+		"has_diff", replica.HasDiff(revs),
+		"sts_updated", replica.StatefulSetUpdated(),
+		"reloaded", replica.Reloaded(revs.ReloadConfigRevision),
+		"reload_error", fmt.Sprint(replica.ReloadError),
+		"queryable", replica.Queryable(),
+		"ready", replica.Ready(),
+		"probe_reload_rev", replica.ReloadConfigRevision,
+		"probe_users_reload_rev", replica.UsersReloadConfigRevision,
+		"desired_reload_rev", revs.ReloadConfigRevision,
+	}
+
+	if replica.STS == nil {
+		return append(kv, "sts_exists", false)
+	}
+
+	kv = append(kv,
+		"sts_spec_hash_match", ctrlutil.GetSpecHashFromObject(replica.STS) == revs.StatefulSetRevision,
+		"sts_restart_hash_match", replica.STS.Spec.Template.Annotations[ctrlutil.AnnotationConfigHash] == revs.RestartConfigRevision,
+		"sts_generation", replica.STS.Generation,
+		"sts_observed_generation", replica.STS.Status.ObservedGeneration,
+		"sts_current_revision", replica.STS.Status.CurrentRevision,
+		"sts_update_revision", replica.STS.Status.UpdateRevision,
+		"configmap_exists", replica.CFG != nil,
+	)
+
+	if replica.CFG != nil {
+		kv = append(kv,
+			"configmap_hash_match", ctrlutil.GetConfigHashFromObject(replica.CFG) == revs.ConfigurationRevision,
+			"configmap_reload_hash", replica.CFG.Annotations[ctrlutil.AnnotationReloadableConfigHash],
+		)
+	}
+
+	var pvcMismatch []string
+	for name, revision := range revs.PVCRevisions {
+		pvc, ok := replica.PVCs[name]
+		if !ok || pvc == nil {
+			pvcMismatch = append(pvcMismatch, name+":missing")
+		} else if ctrlutil.GetSpecHashFromObject(pvc) != revision {
+			pvcMismatch = append(pvcMismatch, name+":spec-hash")
+		}
+	}
+
+	return append(kv, "pvc_mismatch", pvcMismatch)
+}
