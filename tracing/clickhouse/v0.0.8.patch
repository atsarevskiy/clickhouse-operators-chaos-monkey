diff --git a/internal/controller/chaostrace.go b/internal/controller/chaostrace.go
new file mode 100644
index 0000000..85837cd
--- /dev/null
+++ b/internal/controller/chaostrace.go
@@ -0,0 +1,59 @@
+package controller
+
+import (
+	"fmt"
+
+	"sigs.k8s.io/controller-runtime/pkg/client"
+	"sigs.k8s.io/controller-runtime/pkg/event"
+	"sigs.k8s.io/controller-runtime/pkg/predicate"
+
+	util "github.com/ClickHouse/clickhouse-operator/internal/controllerutil"
+)
+
+// TraceEventFilter wraps a controller-wide event filter and logs each watch event with the filter verdict.
+// The returned predicate returns exactly what the wrapped predicate returns.
+func TraceEventFilter(log util.Logger, controllerName string, inner predicate.Predicate) predicate.Predicate {
+	trace := func(eventType string, obj client.Object, passed bool) {
+		if obj == nil {
+			return
+		}
+
+		log.Info("CHAOSTRACE watch-event",
+			"controller", controllerName,
+			"event", eventType,
+			"kind", fmt.Sprintf("%T", obj),
+			"object_namespace", obj.GetNamespace(),
+			"object_name", obj.GetName(),
+			"resource_version", obj.GetResourceVersion(),
+			"deleting", !obj.GetDeletionTimestamp().IsZero(),
+			"passed", passed,
+		)
+	}
+
+	return predicate.Funcs{
+		CreateFunc: func(e event.CreateEvent) bool {
+			passed := inner.Create(e)
+			trace("create", e.Object, passed)
+
+			return passed
+		},
+		UpdateFunc: func(e event.UpdateEvent) bool {
+			passed := inner.Update(e)
+			trace("update", e.ObjectNew, passed)
+
+			return passed
+		},
+		DeleteFunc: func(e event.DeleteEvent) bool {
+			passed := inner.Delete(e)
+			trace("delete", e.Object, passed)
+
+			return passed
+		},
+		GenericFunc: func(e event.GenericEvent) bool {
+			passed := inner.Generic(e)
+			trace("generic", e.Object, passed)
+
+			return passed
+		},
+	}
+}
